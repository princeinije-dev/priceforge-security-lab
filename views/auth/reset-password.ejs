<%- include("../partials/header", { title: "Set New Password" }) %>

<section class="auth-page">
  <div class="auth-image">
    <div>
      <span class="eyebrow eyebrow-light">AUTHENTICATION</span>
      <h1>Set your new<br>account password.</h1>
      <p>Choose a strong password with at least 8 characters to secure your PriceForge orders.</p>
    </div>
  </div>

  <div class="auth-form-side">
    <div class="auth-form-container">
      <span class="eyebrow">CREDENTIAL UPDATE</span>
      <h2>Choose New Password</h2>
      <% if (typeof userEmail !== "undefined" && userEmail) { %>
        <p class="auth-subtitle">Updating credentials for <strong><%= userEmail %></strong></p>
      <% } %>

      <% if (!token) { %>
        <div class="flash-alert flash-error" style="margin-bottom: 20px;">
          <span>This reset link has expired or is invalid.</span>
        </div>
        <a href="/auth/forgot-password" class="btn-primary btn-full-width">Request New Reset Link →</a>
      <% } else { %>
        <form action="/auth/reset-password/<%= token %>" method="POST" class="auth-form">
          <div class="form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="password" placeholder="Minimum 8 characters" class="form-input" minlength="8" required>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" class="form-input" minlength="8" required>
          </div>

          <button type="submit" class="btn-primary btn-full-width">
            Save New Password →
          </button>
        </form>
      <% } %>

      <p class="auth-switch-text">
        <a href="/auth/login">Return to Sign In</a>
      </p>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
