<%- include("../partials/header", { title: "Reset Your Password" }) %>

<section class="auth-page">
  <div class="auth-image">
    <div>
      <span class="eyebrow eyebrow-light">ACCOUNT RECOVERY</span>
      <h1>Restore access to<br>your tech hub.</h1>
      <p>Enter your registered email address and we'll initiate the password recovery process.</p>
    </div>
  </div>

  <div class="auth-form-side">
    <div class="auth-form-container">
      <a href="/auth/login" class="auth-back-link">← Back to Sign In</a>
      <span class="eyebrow">SECURITY RECOVERY</span>
      <h2>Password Reset</h2>
      <p class="auth-subtitle">Enter your account email to generate a reset link.</p>

      <!-- Security Lab Explanatory Box & Token Leakage Output -->
      <% if (typeof tokenPreview !== "undefined" && tokenPreview) { %>
        <div class="lab-instruction-box lab-token-alert">
          <div class="lab-instruction-header">
            <span class="badge-lab">SECURITY LAB VULNERABILITY</span>
            <strong>Simulated Token Leakage in Response</strong>
          </div>
          <p>
            In this local lab environment without an active external SMTP relay, the password reset token is deliberately reflected in the server response:
          </p>
          <div class="token-code-box">
            <code><%= tokenPreview %></code>
          </div>
          <div style="margin-top: 10px;">
            <a href="<%= resetLink %>" class="btn-primary btn-sm">Proceed with this Reset Link →</a>
          </div>
        </div>
      <% } %>

      <form action="/auth/forgot-password" method="POST" class="auth-form">
        <div class="form-group">
          <label for="resetEmail">Email address</label>
          <input type="email" id="resetEmail" name="email" placeholder="you@example.com" class="form-input" required>
        </div>

        <button type="submit" class="btn-primary btn-full-width">
          Initiate Password Reset →
        </button>
      </form>

      <p class="auth-switch-text">
        Remember your password? <a href="/auth/login">Sign in</a>
      </p>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
