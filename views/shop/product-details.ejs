<%- include("../partials/header", { title: product.name }) %>

<div class="container breadcrumbs-row">
  <a href="/products">Shop</a>
  <span>/</span>
  <a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
  <span>/</span>
  <span class="active-crumb"><%= product.name %></span>
</div>

<section class="container product-detail-section">
  <div class="product-detail-layout">
    <!-- Image Gallery -->
    <div class="product-detail-media">
      <div class="main-image-frame">
        <% if (product.image_url) { %>
          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="detail-hero-img">
        <% } else { %>
          <div class="detail-placeholder">NO IMAGE</div>
        <% } %>
        <span class="category-pill-overlay"><%= product.category %></span>
      </div>
    </div>

    <!-- Product Details Info -->
    <div class="product-detail-content">
      <div class="detail-header">
        <span class="eyebrow"><%= product.category.toUpperCase() %> SERIES</span>
        <h1><%= product.name %></h1>

        <div class="detail-rating-line">
          <div class="stars-display">
            <% const avg = ratingStats ? ratingStats.average : 0; %>
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="<%= i <= Math.round(avg) ? 'star-filled' : 'star-empty' %>">★</span>
            <% } %>
          </div>
          <span class="rating-number"><strong><%= avg > 0 ? avg.toFixed(1) : 'Unrated' %></strong></span>
          <span class="rating-divider">•</span>
          <a href="#reviews" class="rating-count-link"><%= ratingStats ? ratingStats.count : 0 %> customer <%= ratingStats && ratingStats.count === 1 ? 'review' : 'reviews' %></a>
        </div>

        <div class="detail-price-box">
          <span class="price-currency">₦</span>
          <span class="price-val"><%= Number(product.price).toLocaleString("en-NG") %></span>
          <span class="vat-note">Tax included • Free nationwide shipping</span>
        </div>
      </div>

      <div class="detail-stock-indicator">
        <% if (product.stock > 10) { %>
          <span class="stock-badge in-stock">
            <span class="pulse-dot"></span> In Stock (<%= product.stock %> units available)
          </span>
        <% } else if (product.stock > 0) { %>
          <span class="stock-badge low-stock">
            <span class="pulse-dot warning"></span> Low Stock: Only <%= product.stock %> units left
          </span>
        <% } else { %>
          <span class="stock-badge out-of-stock">
            <span class="pulse-dot danger"></span> Temporarily Out of Stock
          </span>
        <% } %>
      </div>

      <div class="detail-description-box">
        <h3>Product Overview</h3>
        <p><%= product.description %></p>
      </div>

      <!-- Purchase Actions Form -->
      <% if (product.stock > 0) { %>
        <form action="/cart/add" method="POST" class="detail-purchase-form">
          <input type="hidden" name="productId" value="<%= product.id %>">
          
          <div class="qty-and-cart-row">
            <div class="quantity-stepper">
              <label for="detailQty">Quantity</label>
              <input type="number" id="detailQty" name="quantity" value="1" min="1" max="<%= product.stock %>">
            </div>

            <button type="submit" class="btn-primary btn-add-main">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Shopping Cart</span>
            </button>
          </div>
        </form>
      <% } else { %>
        <div class="sold-out-box">
          <button class="btn-primary btn-add-main disabled" disabled>Currently Unavailable</button>
          <p>This item is currently sold out. Check back soon for stock replenishment.</p>
        </div>
      <% } %>

      <!-- Secondary action: Wishlist -->
      <div class="detail-secondary-actions">
        <form action="/wishlist/add" method="POST">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <button type="submit" class="btn-wishlist-toggle <%= wishlisted ? 'active' : '' %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= wishlisted ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span><%= wishlisted ? 'In Wishlist' : 'Add to Wishlist' %></span>
          </button>
        </form>
      </div>

      <!-- Trust Badges -->
      <div class="product-perks-list">
        <div class="perk-item">
          <span class="perk-icon">🛡️</span>
          <div>
            <strong>1-Year Limited Warranty</strong>
            <small>Direct manufacturer coverage & local replacement</small>
          </div>
        </div>
        <div class="perk-item">
          <span class="perk-icon">📦</span>
          <div>
            <strong>Fast & Secure Handling</strong>
            <small>Same-day dispatch for orders confirmed before 2:00 PM</small>
          </div>
        </div>
        <div class="perk-item">
          <span class="perk-icon">↩️</span>
          <div>
            <strong>Hassle-Free Returns</strong>
            <small>30-day inspection policy on all authentic electronics</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Related Products Section -->
<% if (relatedProducts && relatedProducts.length > 0) { %>
  <section class="container related-products-section">
    <div class="section-title-row">
      <div>
        <span class="eyebrow">COMPATIBLE HARDWARE</span>
        <h2>Related Products in <%= product.category %></h2>
      </div>
      <a href="/products?category=<%= encodeURIComponent(product.category) %>" class="view-all-link">View all <%= product.category %> →</a>
    </div>

    <div class="product-grid related-grid">
      <% relatedProducts.forEach(rel => { %>
        <article class="product-card">
          <a href="/products/<%= rel.id %>" class="product-img-link">
            <% if (rel.image_url) { %>
              <img src="<%= rel.image_url %>" alt="<%= rel.name %>" class="product-thumb">
            <% } else { %>
              <div class="product-placeholder">DEVICE</div>
            <% } %>
          </a>
          <div class="product-body">
            <span class="product-cat-name"><%= rel.category %></span>
            <h3 class="product-title">
              <a href="/products/<%= rel.id %>"><%= rel.name %></a>
            </h3>
            <div class="product-footer-row">
              <strong class="product-price">₦<%= Number(rel.price).toLocaleString("en-NG") %></strong>
              <a href="/products/<%= rel.id %>" class="btn-secondary btn-sm">View</a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </section>
<% } %>

<!-- Product Reviews & Stored XSS Lab Section -->
<section class="container reviews-section" id="reviews">
  <div class="reviews-header-block">
    <div class="rating-overview-card">
      <span class="eyebrow">COMMUNITY FEEDBACK</span>
      <h2>Customer Reviews</h2>
      <div class="big-rating-display">
        <span class="big-number"><%= ratingStats ? ratingStats.average.toFixed(1) : '0.0' %></span>
        <div class="big-stars">
          <% for (let i = 1; i <= 5; i++) { %>
            <span class="<%= i <= Math.round(ratingStats.average) ? 'star-filled' : 'star-empty' %>">★</span>
          <% } %>
          <small>Based on <%= ratingStats.count %> <%= ratingStats.count === 1 ? 'review' : 'reviews' %></small>
        </div>
      </div>
    </div>

    <!-- Review Submission Form -->
    <div class="write-review-card">
      <% if (locals.user) { %>
        <h3>Write a Review</h3>
        <p>Share your authentic experience with this product.</p>
        <form action="/products/<%= product.id %>/reviews" method="POST" class="review-form">
          <div class="form-row">
            <div class="form-group">
              <label for="reviewRating">Rating</label>
              <select name="rating" id="reviewRating" class="form-select" required>
                <option value="5">★★★★★ 5 - Exceptional</option>
                <option value="4">★★★★☆ 4 - Good</option>
                <option value="3">★★★☆☆ 3 - Average</option>
                <option value="2">★★☆☆☆ 2 - Below Expectations</option>
                <option value="1">★☆☆☆☆ 1 - Poor</option>
              </select>
            </div>
            <div class="form-group flex-2">
              <label for="reviewTitle">Headline / Summary</label>
              <input type="text" name="title" id="reviewTitle" placeholder="e.g. Crisp audio and solid build quality" class="form-input">
            </div>
          </div>

          <div class="form-group">
            <label for="reviewComment">Detailed Review</label>
            <textarea name="comment" id="reviewComment" rows="3" placeholder="Tell other customers about performance, ergonomics, battery, or materials..." class="form-textarea" required></textarea>
          </div>

          <button type="submit" class="btn-primary">Post Customer Review →</button>
        </form>
      <% } else { %>
        <div class="login-to-review-box">
          <h3>Have you used this device?</h3>
          <p>Please sign in with your PriceForge account to write a verified customer review.</p>
          <a href="/auth/login?redirect=/products/<%= product.id %>#reviews" class="btn-secondary">Sign In to Review</a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Reviews List -->
  <div class="reviews-list-container">
    <% if (!reviews || reviews.length === 0) { %>
      <div class="no-reviews-box">
        <p>No customer reviews yet. Be the first to share your experience!</p>
      </div>
    <% } else { %>
      <div class="reviews-grid">
        <% reviews.forEach(rev => { %>
          <article class="review-item-card">
            <div class="review-card-top">
              <div class="reviewer-meta">
                <span class="reviewer-avatar"><%= rev.reviewer_name ? rev.reviewer_name.charAt(0).toUpperCase() : 'U' %></span>
                <div>
                  <strong><%= rev.reviewer_name %></strong>
                  <span class="verified-buyer-tag">✓ Verified Buyer</span>
                </div>
              </div>
              <div class="review-stars-date">
                <div class="stars-gold">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <span class="<%= i <= rev.rating ? 'star-filled' : 'star-empty' %>">★</span>
                  <% } %>
                </div>
                <time><%= new Date(rev.created_at).toLocaleDateString("en-NG", { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
              </div>
            </div>

            <% if (rev.title) { %>
              <h4 class="review-headline"><%= rev.title %></h4>
            <% } %>

            <!-- INTENTIONAL LAB VULNERABILITY (Stored XSS):
                 Review comment is rendered unescaped via <%- %> to enable demonstration of Stored XSS in this designated lab spot -->
            <div class="review-body-text">
              <%- rev.comment %>
            </div>

            <% if (locals.user && (locals.user.id === rev.user_id || locals.user.role === 'admin')) { %>
              <div class="review-owner-actions">
                <form action="/products/<%= product.id %>/reviews/<%= rev.id %>/delete" method="POST" onsubmit="return confirm('Delete this review?')">
                  <button type="submit" class="btn-text-danger">Delete Review</button>
                </form>
              </div>
            <% } %>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include("../partials/footer") %>
