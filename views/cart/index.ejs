<%- include("../partials/header", { title: "Shopping Cart" }) %>

<section class="container cart-page">
  <div class="page-header-row">
    <div>
      <span class="eyebrow">ORDER SELECTION</span>
      <h1>Shopping Cart</h1>
      <p>Review items, adjust quantities, and proceed to checkout.</p>
    </div>
    <% if (items && items.length > 0) { %>
      <form action="/cart/clear" method="POST" onsubmit="return confirm('Clear all items from your cart?')">
        <button type="submit" class="btn-secondary btn-sm">Clear Cart</button>
      </form>
    <% } %>
  </div>

  <% if (!items || items.length === 0) { %>
    <div class="empty-page-card">
      <div class="empty-page-icon">🛒</div>
      <h2>Your shopping cart is empty</h2>
      <p>You haven't added any electronics to your cart yet.</p>
      <a href="/products" class="btn-primary">Browse Catalog →</a>
    </div>
  <% } else { %>
    <div class="cart-grid-layout">
      <!-- Items List -->
      <div class="cart-items-panel">
        <div class="cart-items-card">
          <table class="cart-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
                <tr class="cart-row">
                  <td>
                    <div class="cart-item-desc">
                      <a href="/products/<%= item.product_id %>" class="cart-thumb-link">
                        <% if (item.image_url) { %>
                          <img src="<%= item.image_url %>" alt="<%= item.name %>">
                        <% } else { %>
                          <div class="cart-thumb-placeholder">TECH</div>
                        <% } %>
                      </a>
                      <div>
                        <span class="category-pill-xs"><%= item.category || 'Gear' %></span>
                        <h4><a href="/products/<%= item.product_id %>"><%= item.name %></a></h4>
                        <small class="stock-note">
                          <%= item.stock >= item.quantity ? `${item.stock} in stock` : `Only ${item.stock} available!` %>
                        </small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="cart-unit-price">₦<%= Number(item.price).toLocaleString("en-NG") %></span>
                  </td>
                  <td>
                    <form action="/cart/<%= item.id %>/update" method="POST" class="cart-qty-form">
                      <input 
                        type="number" 
                        name="quantity" 
                        value="<%= item.quantity %>" 
                        min="1" 
                        max="<%= item.stock %>"
                        class="cart-qty-input"
                      >
                      <button type="submit" class="btn-qty-update" title="Update quantity">Update</button>
                    </form>
                  </td>
                  <td>
                    <strong class="cart-line-total">
                      ₦<%= (Number(item.price) * item.quantity).toLocaleString("en-NG") %>
                    </strong>
                  </td>
                  <td>
                    <form action="/cart/<%= item.id %>/remove" method="POST">
                      <button type="submit" class="cart-remove-icon-btn" title="Remove item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <div class="cart-reassurance-strip">
          <div><span>🔒</span> Secure 256-bit encrypted checkout</div>
          <div><span>🚚</span> Fast dispatch within 24 hours</div>
          <div><span>💬</span> 7-day customer support</div>
        </div>
      </div>

      <!-- Order Summary Aside -->
      <aside class="cart-summary-panel">
        <div class="summary-card">
          <span class="eyebrow">ORDER TOTAL</span>
          <h3>Summary</h3>

          <div class="summary-line-item">
            <span>Subtotal (<%= items.reduce((sum, item) => sum + item.quantity, 0) %> items)</span>
            <span>₦<%= Number(total).toLocaleString("en-NG") %></span>
          </div>

          <div class="summary-line-item">
            <span>Estimated Shipping</span>
            <span class="text-free">FREE</span>
          </div>

          <div class="summary-divider"></div>

          <div class="summary-total-item">
            <strong>Estimated Total</strong>
            <strong class="total-highlight">₦<%= Number(total).toLocaleString("en-NG") %></strong>
          </div>

          <a href="/orders/checkout" class="btn-primary btn-checkout-proceed">
            Proceed to Checkout →
          </a>

          <a href="/products" class="btn-return-link">← Continue Shopping</a>
        </div>
      </aside>
    </div>
  <% } %>
</section>

<%- include("../partials/footer") %>
