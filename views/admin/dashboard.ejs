<%- include("../partials/admin-header", { title: "Admin Overview" }) %>

<div class="admin-page-header">
  <div>
    <span class="eyebrow">COMMAND CONSOLE</span>
    <h1>Operations Dashboard</h1>
    <p>Real-time analytics, inventory levels, and order management metrics.</p>
  </div>
  <div class="admin-header-actions">
    <a href="/admin/products/new" class="btn-primary btn-sm">+ New Product</a>
    <a href="/admin/orders" class="btn-secondary btn-sm">All Orders →</a>
  </div>
</div>

<!-- Stats Grid -->
<div class="admin-stats-grid">
  <div class="admin-stat-card">
    <div class="stat-card-top">
      <span class="stat-title">Gross Revenue</span>
      <span class="stat-badge-trend">Live</span>
    </div>
    <div class="stat-primary-val">₦<%= Number(stats.totalRevenue).toLocaleString("en-NG") %></div>
    <small class="stat-subtext">Cumulative settled orders</small>
  </div>

  <div class="admin-stat-card">
    <div class="stat-card-top">
      <span class="stat-title">Total Orders</span>
      <span class="stat-badge-info"><%= stats.pendingOrders %> pending</span>
    </div>
    <div class="stat-primary-val"><%= stats.totalOrders %></div>
    <small class="stat-subtext">Across all fulfillment stages</small>
  </div>

  <div class="admin-stat-card">
    <div class="stat-card-top">
      <span class="stat-title">Active Customers</span>
      <span class="stat-badge-trend">Registered</span>
    </div>
    <div class="stat-primary-val"><%= stats.totalCustomers %></div>
    <small class="stat-subtext">Verified accounts in system</small>
  </div>

  <div class="admin-stat-card <%= stats.lowStockCount > 0 ? 'card-warning' : '' %>">
    <div class="stat-card-top">
      <span class="stat-title">Hardware Catalog</span>
      <% if (stats.lowStockCount > 0) { %>
        <span class="stat-badge-warning"><%= stats.lowStockCount %> Low Stock</span>
      <% } else { %>
        <span class="stat-badge-trend">Healthy</span>
      <% } %>
    </div>
    <div class="stat-primary-val"><%= stats.totalProducts %></div>
    <small class="stat-subtext">Active catalog SKUs</small>
  </div>
</div>

<div class="admin-dashboard-layout">
  <!-- Recent Orders Table -->
  <div class="admin-main-panel">
    <div class="panel-card">
      <div class="panel-header-row">
        <div>
          <h3>Recent Fulfillment Orders</h3>
          <p class="text-muted">Latest checkouts placed through storefront</p>
        </div>
        <a href="/admin/orders" class="btn-secondary btn-xs">View All Orders</a>
      </div>

      <% if (!recentOrders || recentOrders.length === 0) { %>
        <div class="panel-empty-state">
          <p>No orders placed yet in the database.</p>
        </div>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Order Ref</th>
              <th>Customer</th>
              <th>Date</th>
              <th>Items</th>
              <th>Total</th>
              <th>Status</th>
              <th class="text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(ord => { %>
              <tr>
                <td><strong>#<%= ord.id %></strong></td>
                <td>
                  <div>
                    <span><%= ord.user_name %></span>
                    <small class="text-muted d-block"><%= ord.user_email %></small>
                  </div>
                </td>
                <td><%= new Date(ord.created_at).toLocaleDateString("en-NG") %></td>
                <td><%= ord.item_count || 1 %></td>
                <td><strong>₦<%= Number(ord.total_amount).toLocaleString("en-NG") %></strong></td>
                <td>
                  <span class="status-badge status-<%= ord.status.toLowerCase() %>"><%= ord.status %></span>
                </td>
                <td class="text-right">
                  <a href="/admin/orders/<%= ord.id %>" class="btn-secondary btn-xs">Manage</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- Low Stock & Best Sellers Side Panel -->
  <div class="admin-side-panel">
    <!-- Low Stock Card -->
    <div class="panel-card" style="margin-bottom: 24px;">
      <div class="panel-header-row">
        <h3>Low Inventory Alerts</h3>
        <span class="badge-lab" style="font-size: 11px;">≤ 10 Units</span>
      </div>

      <% if (!lowStock || lowStock.length === 0) { %>
        <p class="text-muted" style="padding: 12px 0;">All product inventory levels are above the reorder threshold.</p>
      <% } else { %>
        <div class="low-stock-list">
          <% lowStock.forEach(item => { %>
            <div class="low-stock-item">
              <div>
                <strong><%= item.name %></strong>
                <small class="d-block text-muted"><%= item.category %> • ₦<%= Number(item.price).toLocaleString("en-NG") %></small>
              </div>
              <div class="stock-action-group">
                <span class="stock-num-pill <%= item.stock === 0 ? 'empty' : 'warning' %>">
                  <%= item.stock %> left
                </span>
                <a href="/admin/products/<%= item.id %>/edit" class="btn-text-primary btn-xs">Restock</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Best Sellers Card -->
    <div class="panel-card">
      <div class="panel-header-row">
        <h3>Top Performing Gear</h3>
      </div>
      <% if (!bestSellers || bestSellers.length === 0) { %>
        <p class="text-muted" style="padding: 12px 0;">Sales rankings will populate once orders are completed.</p>
      <% } else { %>
        <div class="bestsellers-list">
          <% bestSellers.forEach((item, idx) => { %>
            <div class="bestseller-item">
              <span class="rank-badge">#<%= idx + 1 %></span>
              <div class="item-meta">
                <strong><%= item.name %></strong>
                <small class="text-muted"><%= item.total_sold %> units sold</small>
              </div>
              <strong>₦<%= Number(item.price).toLocaleString("en-NG") %></strong>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include("../partials/admin-footer") %>
