<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== "undefined" ? title + " | PriceForge Admin" : "PriceForge Admin Console" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-header">
      <a href="/admin" class="admin-brand">
        <span class="brand-mark">P</span>
        <span>priceforge<span class="admin-badge">ADMIN</span></span>
      </a>
      <button class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close menu">✕</button>
    </div>

    <nav class="admin-nav">
      <div class="admin-nav-section">OVERVIEW</div>
      <a href="/admin" class="admin-nav-link <%= locals.currentPath === '/admin' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span>Dashboard</span>
      </a>

      <div class="admin-nav-section">MANAGEMENT</div>
      <a href="/admin/products" class="admin-nav-link <%= locals.currentPath && locals.currentPath.startsWith('/admin/products') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span>Products</span>
      </a>
      <a href="/admin/orders" class="admin-nav-link <%= locals.currentPath && locals.currentPath.startsWith('/admin/orders') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span>Orders</span>
      </a>
      <a href="/admin/customers" class="admin-nav-link <%= locals.currentPath && locals.currentPath.startsWith('/admin/customers') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <span>Customers</span>
      </a>
      <a href="/admin/coupons" class="admin-nav-link <%= locals.currentPath && locals.currentPath.startsWith('/admin/coupons') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
        <span>Coupons</span>
      </a>
      <a href="/admin/reviews" class="admin-nav-link <%= locals.currentPath && locals.currentPath.startsWith('/admin/reviews') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <span>Reviews</span>
      </a>

      <div class="admin-nav-section">SECURITY LAB</div>
      <a href="/admin/api/unprotected-stats" target="_blank" class="admin-nav-link lab-nav-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>Broken AC API ↗</span>
      </a>
    </nav>

    <div class="admin-sidebar-footer">
      <a href="/products" class="btn-storefront">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>View Storefront</span>
      </a>
    </div>
  </aside>

  <!-- Admin Main Container -->
  <div class="admin-content-area">
    <header class="admin-topbar">
      <div class="topbar-left">
        <button class="mobile-sidebar-toggle" id="sidebarToggleBtn" aria-label="Toggle navigation">☰</button>
        <span class="admin-breadcrumb"><%= typeof title !== "undefined" ? title : "Administration" %></span>
      </div>
      <div class="topbar-right">
        <span class="admin-user-pill">
          <span class="user-avatar-initial sm">A</span>
          <span><%= locals.user ? locals.user.name : "Admin" %></span>
          <span class="role-badge role-admin">admin</span>
        </span>
        <form action="/auth/logout" method="POST" style="margin: 0;">
          <button type="submit" class="admin-logout-btn">Sign out</button>
        </form>
      </div>
    </header>

    <main class="admin-page-content">
      <%- include("./flash") %>
