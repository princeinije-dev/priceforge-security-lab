<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#4f46e5">
  <title><%= typeof title !== "undefined" ? title + " | PriceForge" : "PriceForge — Premium Electronics" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

<header class="site-header">
  <!-- Top announcement banner -->
  <div class="top-banner">
    <div class="header-inner banner-content">
      <span>🚀 Free express delivery on orders over ₦50,000 | Use code <strong>FORGE10</strong> for 10% off</span>
      <div class="banner-links">
        <a href="/products/search/vulnerable" class="lab-pill-link">🧪 SQLi Lab Search</a>
        <% if (locals.user && locals.user.role === 'admin') { %>
          <a href="/admin" class="banner-admin-link">⚙️ Admin Console</a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="header-inner main-header-row">
    <a href="/products" class="brand">
      <span class="brand-mark">P</span>
      <span>priceforge<span class="brand-dot">.</span></span>
    </a>

    <!-- Global search form -->
    <form action="/products" method="GET" class="header-search-form">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input 
          type="text" 
          name="search" 
          placeholder="Search headphones, keyboards, hubs..." 
          value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>"
          autocomplete="off"
        >
        <% if (typeof currentCategory !== 'undefined' && currentCategory && currentCategory !== 'all') { %>
          <input type="hidden" name="category" value="<%= currentCategory %>">
        <% } %>
      </div>
    </form>

    <nav class="main-nav">
      <a href="/products" class="<%= typeof currentCategory !== 'undefined' && currentCategory === 'all' ? 'active' : '' %>">All Tech</a>
      <a href="/products?category=Audio">Audio</a>
      <a href="/products?category=Gaming">Gaming</a>
      <a href="/products?category=Accessories">Accessories</a>
      <a href="/products?category=Connectivity">Connectivity</a>
    </nav>

    <div class="header-actions">
      <% if (locals.user) { %>
        <a href="/wishlist" class="header-action-btn" title="My Wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </a>

        <a href="/cart" class="header-cart" title="Shopping Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span class="cart-label">Cart</span>
          <span class="cart-badge"><%= locals.cartCount || 0 %></span>
        </a>

        <div class="user-menu-wrap">
          <button class="user-menu-trigger" type="button">
            <span class="user-avatar-initial"><%= locals.user.name.charAt(0).toUpperCase() %></span>
            <span class="user-display-name"><%= locals.user.name.split(" ")[0] %></span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="user-dropdown-menu">
            <div class="user-dropdown-header">
              <strong><%= locals.user.name %></strong>
              <small><%= locals.user.email %></small>
              <span class="role-badge role-<%= locals.user.role %>"><%= locals.user.role %></span>
            </div>
            <% if (locals.user.role === 'admin') { %>
              <a href="/admin" class="user-dropdown-item admin-highlight">⚡ Admin Dashboard</a>
            <% } %>
            <a href="/account" class="user-dropdown-item">👤 Account Dashboard</a>
            <a href="/orders" class="user-dropdown-item">📦 My Orders</a>
            <a href="/account/addresses" class="user-dropdown-item">📍 Delivery Addresses</a>
            <a href="/account/profile" class="user-dropdown-item">⚙️ Profile & Password</a>
            <hr>
            <form action="/auth/logout" method="POST" class="logout-form">
              <button type="submit" class="logout-button">Sign out</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/cart" class="header-cart" title="Shopping Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span class="cart-label">Cart</span>
          <span class="cart-badge"><%= locals.cartCount || 0 %></span>
        </a>
        <a href="/auth/login" class="header-login">Sign in</a>
        <a href="/auth/register" class="btn-primary btn-sm">Create account</a>
      <% } %>
    </div>
  </div>
</header>

<main class="site-main">
  <%- include("./flash") %>
