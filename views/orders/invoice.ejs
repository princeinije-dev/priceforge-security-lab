<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice #<%= order.id %> — PriceForge</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: #f8fafc; padding: 40px 20px; font-family: 'DM Sans', sans-serif; }
    .invoice-card { max-width: 800px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .invoice-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #e2e8f0; padding-bottom: 24px; margin-bottom: 30px; }
    .invoice-title { font-size: 28px; font-weight: 800; color: #0f172a; margin-top: 10px; }
    .invoice-meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; margin-bottom: 30px; }
    .invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
    .invoice-table th, .invoice-table td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; text-align: left; }
    .invoice-table th { background: #f1f5f9; font-weight: 700; color: #334155; }
    .invoice-summary { max-width: 300px; margin-left: auto; }
    .invoice-summary .line { display: flex; justify-content: space-between; padding: 8px 0; }
    .invoice-summary .total { font-size: 20px; font-weight: 800; color: #4f46e5; border-top: 2px solid #0f172a; padding-top: 12px; }
    .print-bar { max-width: 800px; margin: 0 auto 20px; display: flex; justify-content: space-between; align-items: center; }
    @media print {
      body { background: #fff; padding: 0; }
      .print-bar { display: none; }
      .invoice-card { box-shadow: none; border-radius: 0; padding: 0; }
    }
  </style>
</head>
<body>

<div class="print-bar">
  <a href="/orders/<%= order.id %>" class="btn-secondary btn-sm">← Back to Order</a>
  <button onclick="window.print()" class="btn-primary btn-sm">🖨️ Print Invoice</button>
</div>

<div class="invoice-card">
  <div class="invoice-header">
    <div>
      <div class="brand">
        <span class="brand-mark">P</span>
        <span style="font-size: 24px; font-weight: 800; color: #0f172a;">priceforge.</span>
      </div>
      <p style="color: #64748b; margin-top: 6px;">Electronics & Hardware Direct</p>
    </div>
    <div style="text-align: right;">
      <span class="badge-lab" style="font-size: 11px;">TAX INVOICE</span>
      <div class="invoice-title">#<%= order.id %></div>
      <p style="color: #64748b; margin: 4px 0 0;">Date: <%= new Date(order.created_at).toLocaleDateString("en-NG", { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <p style="color: #64748b; margin: 0;">Status: <strong><%= order.status %></strong></p>
    </div>
  </div>

  <div class="invoice-meta-grid">
    <div>
      <h4 style="margin: 0 0 8px; color: #64748b; font-size: 12px; text-transform: uppercase;">Billed & Delivered To</h4>
      <strong style="font-size: 16px; color: #0f172a;"><%= order.user_name %></strong>
      <p style="color: #475569; margin: 4px 0;"><%= order.user_email %></p>
      <p style="color: #475569; margin: 4px 0; font-size: 13px;"><%= order.shipping_address_text || 'Standard delivery address on file' %></p>
    </div>
    <div style="text-align: right;">
      <h4 style="margin: 0 0 8px; color: #64748b; font-size: 12px; text-transform: uppercase;">Payment Details</h4>
      <p style="color: #475569; margin: 4px 0;">Method: Direct Electronic Checkout</p>
      <p style="color: #475569; margin: 4px 0;">Currency: Nigerian Naira (₦)</p>
      <p style="color: #475569; margin: 4px 0; font-size: 13px;">Order ID: <strong>#<%= order.id %></strong></p>
    </div>
  </div>

  <table class="invoice-table">
    <thead>
      <tr>
        <th>Item Description</th>
        <th style="text-align: center;">Qty</th>
        <th style="text-align: right;">Unit Price</th>
        <th style="text-align: right;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <td>
            <strong><%= item.product_name %></strong>
          </td>
          <td style="text-align: center;"><%= item.quantity %></td>
          <td style="text-align: right;">₦<%= Number(item.unit_price).toLocaleString("en-NG") %></td>
          <td style="text-align: right;">₦<%= Number(item.subtotal).toLocaleString("en-NG") %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="invoice-summary">
    <div class="line">
      <span>Subtotal</span>
      <span>₦<%= Number(order.subtotal_amount || order.total_amount).toLocaleString("en-NG") %></span>
    </div>
    <% if (order.discount_amount > 0) { %>
      <div class="line" style="color: #10b981;">
        <span>Discount (<%= order.coupon_code || 'PROMO' %>)</span>
        <span>-₦<%= Number(order.discount_amount).toLocaleString("en-NG") %></span>
      </div>
    <% } %>
    <div class="line">
      <span>Shipping</span>
      <span>₦0.00 (FREE)</span>
    </div>
    <div class="line total">
      <span>Grand Total</span>
      <span>₦<%= Number(order.total_amount).toLocaleString("en-NG") %></span>
    </div>
  </div>

  <div style="margin-top: 50px; border-top: 1px solid #e2e8f0; padding-top: 20px; text-align: center; color: #94a3b8; font-size: 12px;">
    Thank you for choosing PriceForge. For technical support or warranty inquiries, contact support@priceforge.local.
  </div>
</div>

</body>
</html>
